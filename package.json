{
  "name": "@antv/g6-gl",
  "version": "0.1.0-beta.22",
  "description": "A high-performance graph analysis engine based on WebGL, designed for large-scale graph data analysis.",
  "type": "module",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "clean:dist": "node scripts/clean-dist.mjs",
    "build": "npm run clean:dist && tsc && tsc -p tsconfig.dist-declarations.json && node scripts/check-public-declarations.mjs && node scripts/check-esm-package.mjs",
    "build:playground": "npx vite build",
    "check:package": "tsc -p tsconfig.package-nodenext.json && tsc -p tsconfig.package-bundler.json && node scripts/check-vite-package.mjs && node scripts/check-pack-manifest.mjs",
    "dev": "vite playground",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.public-api.json",
    "prepare": "husky",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "format": "prettier --write \"src/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "site:dev": "npm --prefix site run dev",
    "site:build": "npm run docs:api && npm --prefix site run build",
    "docs:api": "typedoc",
    "size": "size-limit",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "npm run build && npm run check:package && changeset publish",
    "ci": "npm run lint && npm run typecheck && npm run test:cov && npm run build && npm run check:package && npm run size"
  },
  "keywords": [
    "graph",
    "visualization",
    "webgl",
    "antv",
    "g6"
  ],
  "license": "MIT",
  "devDependencies": {
    "@changesets/cli": "^2.31.0",
    "@eslint/js": "^10.0.1",
    "@size-limit/preset-small-lib": "^12.1.0",
    "@vitest/coverage-v8": "^3.2.6",
    "eslint": "~10.3.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.5",
    "husky": "^9.1.7",
    "jsdom": "^29.1.1",
    "lil-gui": "^0.21.0",
    "lint-staged": "^15.5.2",
    "prettier": "^3.8.3",
    "size-limit": "^12.1.0",
    "stats.js": "^0.17.0",
    "typedoc": "^0.28.19",
    "typedoc-plugin-frontmatter": "^1.3.1",
    "typedoc-plugin-markdown": "^4.12.0",
    "typescript": "^5.3.3",
    "typescript-eslint": "^8.59.3",
    "vite": "^5.4.0",
    "vitest": "^3.2.4"
  },
  "dependencies": {
    "@antv/graphlib": "^2.0.0",
    "@antv/layout": "^2.0.0"
  },
  "engines": {
    "node": ">=20"
  },
  "lint-staged": {
    "src/**/*.ts": [
      "eslint --fix",
      "prettier --write"
    ]
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/antvis/G6Lite"
  },
  "homepage": "https://github.com/antvis/G6Lite#readme",
  "bugs": {
    "url": "https://github.com/antvis/G6Lite/issues"
  },
  "author": "AntV",
  "sideEffects": false
}
