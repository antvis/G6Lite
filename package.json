{
  "name": "@antv/g6-gl",
  "version": "0.1.0-beta.22",
  "description": "A lightweight, high-performance WebGL graph visualization engine.",
  "type": "module",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "dev": "vite playground",
    "build": "rm -rf dist && tsc && node scripts/add-js-extensions.mjs && tsc -p tsconfig.dist-declarations.json && tsc -p tsconfig.package-nodenext.json && tsc -p tsconfig.package-bundler.json && node scripts/check-package.mjs",
    "build:playground": "vite build",
    "examples:check": "node scripts/check-examples.mjs",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.public-api.json && tsc -p tsconfig.perf.json && tsc -p tsconfig.playground.json",
    "lint": "eslint src tests vite.config.ts vitest.config.ts",
    "test": "vitest run",
    "benchmark": "npm run build && node tests/perf/run.js",
    "benchmark:compare": "node tests/perf/compare.js",
    "docs:api": "typedoc",
    "site:dev": "npm --prefix site run dev",
    "site:check": "node scripts/check-site.mjs",
    "site:output-check": "node scripts/check-site-output.mjs",
    "site:build": "npm run docs:api && npm run build:playground && npm run site:check && npm --prefix site run build && node scripts/copy-playground-to-site.mjs && npm run site:output-check",
    "size": "size-limit",
    "ci": "npm run lint && npm run typecheck && npm test -- --coverage && npm run build && npm run size"
  },
  "keywords": [
    "graph",
    "visualization",
    "webgl",
    "antv",
    "g6"
  ],
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@size-limit/preset-small-lib": "^12.1.0",
    "@types/benchmark": "^2.1.5",
    "@types/lodash": "^4.17.24",
    "@types/node": "^20.0.0",
    "@types/platform": "^1.3.6",
    "@vitest/coverage-v8": "^3.2.6",
    "benchmark": "^2.1.4",
    "eslint": "~10.3.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.5",
    "jsdom": "^29.1.1",
    "lodash": "^4.18.1",
    "platform": "^1.3.6",
    "playwright": "^1.61.1",
    "prettier": "3.9.6",
    "size-limit": "^12.1.0",
    "typedoc": "^0.28.19",
    "typedoc-plugin-frontmatter": "^1.3.1",
    "typedoc-plugin-markdown": "^4.12.0",
    "typescript": "^5.3.3",
    "typescript-eslint": "^8.59.3",
    "vite": "^5.4.0",
    "vitest": "^3.2.4"
  },
  "dependencies": {
    "@antv/layout": "^2.0.0"
  },
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/antvis/G6Lite"
  },
  "homepage": "https://g6-gl.antv.vision",
  "bugs": {
    "url": "https://github.com/antvis/G6Lite/issues"
  },
  "author": "AntV",
  "sideEffects": false
}
