{
  "name": "@antv/g6-lite",
  "version": "0.1.0-beta.27",
  "description": "A lightweight, high-performance WebGL graph visualization engine.",
  "type": "module",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "unpkg": "dist/g6-lite.min.js",
  "jsdelivr": "dist/g6-lite.min.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "dev": "vite playground",
    "build": "rimraf dist && rollup -c",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src tests vite.config.ts vitest.config.ts",
    "test": "vitest run",
    "size": "limit-size",
    "ci": "npm run lint && npm run typecheck && npm test && npm run build && npm run size",
    "site": "vite build && node scripts/check-site.mjs && npm --prefix site run build && node scripts/copy-playground-to-site.mjs && node scripts/check-site-output.mjs"
  },
  "limit-size": [
    {
      "path": "dist/g6-lite.min.js",
      "limit": "200 KB",
      "gzip": true
    },
    {
      "path": "dist/index.js",
      "limit": "100 KB",
      "gzip": true
    }
  ],
  "keywords": [
    "graph",
    "visualization",
    "webgl",
    "antv",
    "g6"
  ],
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@rollup/plugin-commonjs": "^29.0.3",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-terser": "^1.0.2",
    "@rollup/plugin-typescript": "^12.3.1",
    "@types/lodash": "^4.17.24",
    "@types/node": "^20.0.0",
    "@types/platform": "^1.3.6",
    "eslint": "~10.3.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.5",
    "jsdom": "^29.1.1",
    "limit-size": "^0.1.4",
    "lodash": "^4.18.1",
    "platform": "^1.3.6",
    "playwright": "^1.61.1",
    "prettier": "3.9.6",
    "rimraf": "^6.1.3",
    "rollup": "^4.66.0",
    "rollup-plugin-dts": "^6.5.1",
    "typescript": "^5.3.3",
    "typescript-eslint": "^8.59.3",
    "vite": "^5.4.0",
    "vitest": "^3.2.4"
  },
  "dependencies": {
    "@antv/event-emitter": "^0.1.3",
    "@antv/layout": "^2.0.0",
    "regl": "^2.1.1"
  },
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/antvis/G6Lite"
  },
  "homepage": "https://g6lite.antv.vision",
  "bugs": {
    "url": "https://github.com/antvis/G6Lite/issues"
  },
  "author": "AntV",
  "sideEffects": false
}
