    "graph",
    "visualization",
    "webgl",
    "antv",
    "g6"
  ],
  "license": "MIT",
  "devDependencies": {
    "typescript": "^5.3.3",
    "vite": "^5.4.0"
  },
  "dependencies": {
    "@antv/graphlib": "^2.0.0",
    "@antv/layout": "^2.0.0"
  },
  "peerDependencies": {},
  "engines": {
    "node": ">=18"
  }
}
