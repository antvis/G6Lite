{
  "name": "@antv/g6-lite",
  "version": "0.1.0",
  "description": "A high-performance graph analysis engine based on WebGL, designed for large-scale graph data analysis.",
  "type": "module",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "vite playground",
    "typecheck": "tsc --noEmit"
  },
