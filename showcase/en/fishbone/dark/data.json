{"source":"import { Graph, register } from '@antv/g6-lite';\nimport fishbone from '@antv/g6-lite/layouts/fishbone';\n\nregister('layout', 'fishbone', fishbone);\n\n// HTML: <div id=\"container\" style=\"height: 360px\"></div>\nconst data = {\n  nodes: [\n    {\"id\":\"Delay\",\"data\":{\"fill\":\"#aabaf4\",\"stroke\":\"#c0ceff\",\"labelColor\":\"#182340\"}},\n    {\"id\":\"People\",\"data\":{\"fill\":\"#243954\",\"stroke\":\"#79a4df\",\"labelColor\":\"#c0d9ff\"}},\n    {\"id\":\"Process\",\"data\":{\"fill\":\"#203d35\",\"stroke\":\"#6bb9a0\",\"labelColor\":\"#b6e6d5\"}},\n    {\"id\":\"Tech\",\"data\":{\"fill\":\"#463820\",\"stroke\":\"#d4ad66\",\"labelColor\":\"#f3d69c\"}},\n    {\"id\":\"Resources\",\"data\":{\"fill\":\"#462c3d\",\"stroke\":\"#d690b2\",\"labelColor\":\"#f4c3da\"}},\n    {\"id\":\"Handoffs\",\"data\":{\"fill\":\"#243954\",\"stroke\":\"#79a4df\",\"labelColor\":\"#c0d9ff\"}},\n    {\"id\":\"Scope\",\"data\":{\"fill\":\"#203d35\",\"stroke\":\"#6bb9a0\",\"labelColor\":\"#b6e6d5\"}},\n    {\"id\":\"API\",\"data\":{\"fill\":\"#463820\",\"stroke\":\"#d4ad66\",\"labelColor\":\"#f3d69c\"}},\n    {\"id\":\"Schedule\",\"data\":{\"fill\":\"#462c3d\",\"stroke\":\"#d690b2\",\"labelColor\":\"#f4c3da\"}}\n  ],\n  edges: [\n    {\"source\":\"Delay\",\"target\":\"People\"},\n    {\"source\":\"Delay\",\"target\":\"Process\"},\n    {\"source\":\"Delay\",\"target\":\"Tech\"},\n    {\"source\":\"Delay\",\"target\":\"Resources\"},\n    {\"source\":\"People\",\"target\":\"Handoffs\"},\n    {\"source\":\"Process\",\"target\":\"Scope\"},\n    {\"source\":\"Tech\",\"target\":\"API\"},\n    {\"source\":\"Resources\",\"target\":\"Schedule\"}\n  ],\n};\n\nconst graph = new Graph({\n  container: '#container',\n  data,\n  \"theme\": {\n    \"type\": \"dark\",\n    \"canvasBackground\": \"#10151c\"\n  },\n  \"autoFit\": {\n    \"padding\": 24\n  },\n  \"label\": {\n    \"scaleWithZoom\": false\n  },\n  \"node\": {\n    \"type\": \"rect\",\n    \"style\": {\n      \"width\": 80,\n 