{"source":"import { Graph, register } from '@antv/g6-lite';\nimport mindmap from '@antv/g6-lite/layouts/mindmap';\n\nregister('layout', 'mindmap', mindmap);\n\n// HTML: <div id=\"container\" style=\"height: 360px\"></div>\nconst data = {\n  nodes: [\n    {\"id\":\"Project\",\"data\":{\"fill\":\"#aabaf4\",\"stroke\":\"#c0ceff\",\"labelColor\":\"#182340\"}},\n    {\"id\":\"Goals\",\"data\":{\"side\":\"left\",\"fill\":\"#243954\",\"stroke\":\"#79a4df\",\"labelColor\":\"#c0d9ff\"}},\n    {\"id\":\"Design\",\"data\":{\"side\":\"left\",\"fill\":\"#462c3d\",\"stroke\":\"#d690b2\",\"labelColor\":\"#f4c3da\"}},\n    {\"id\":\"Build\",\"data\":{\"side\":\"right\",\"fill\":\"#203d35\",\"stroke\":\"#6bb9a0\",\"labelColor\":\"#b6e6d5\"}},\n    {\"id\":\"Delivery\",\"data\":{\"side\":\"right\",\"fill\":\"#463820\",\"stroke\":\"#d4ad66\",\"labelColor\":\"#f3d69c\"}},\n    {\"id\":\"User needs\",\"data\":{\"side\":\"left\",\"fill\":\"#243954\",\"stroke\":\"#79a4df\",\"labelColor\":\"#c0d9ff\"}},\n    {\"id\":\"Interaction\",\"data\":{\"side\":\"left\",\"fill\":\"#462c3d\",\"stroke\":\"#d690b2\",\"labelColor\":\"#f4c3da\"}},\n    {\"id\":\"Validation\",\"data\":{\"side\":\"right\",\"fill\":\"#203d35\",\"stroke\":\"#6bb9a0\",\"labelColor\":\"#b6e6d5\"}},\n    {\"id\":\"Release\",\"data\":{\"side\":\"right\",\"fill\":\"#463820\",\"stroke\":\"#d4ad66\",\"labelColor\":\"#f3d69c\"}}\n  ],\n  edges: [\n    {\"source\":\"Project\",\"target\":\"Goals\"},\n    {\"source\":\"Project\",\"target\":\"Design\"},\n    {\"source\":\"Project\",\"target\":\"Build\"},\n    {\"source\":\"Project\",\"target\":\"Delivery\"},\n    {\"source\":\"Goals\",\"target\":\"User needs\"},\n    {\"source\":\"Design\",\"target\":\"Interaction\"},\n    {\"source\":\"Build\",\"target\":\"Validation\"},\n    {\"source\":\"Delivery\",\"target\":\"Release\"}\n  ],\n};\n\nconst graph = new Graph({\n  container: '#container',\n  data,\n  \"theme\": {\n    \"type\": \"dark\",\n    \"canvasBackground\": \"#10151c\"\n  },\n  \"autoFit\": {\n    \"padding\": 24\n  },\n  \"label\": {\n    \"scaleWithZoom\": false\n  },\n  \"node\": {\n    \"type\": \"rect\",\n    \"style\": {\n      \"width\": 100,\n      \"height\": 36,\n      \"borderRadius\": 8,\n      \"fill\": e=>String(e.data?.fill??\"#7087cf\"),\n      \"stroke\": e=>String(e.data?.stroke??\"#c7d1f0\"),\n      \"strokeWidth\": 1,\n      \"label\": e=>e.id,\n      \"labelPlacement\": \"center\",\n      \"labelFontSize\": 13,\n      \"labelColor\": e=>String(e.data?.labelColor??\"#3d508e\")\n    }\n  },\n  \"edge\": {\n    \"type\": \"cubic\",\n    \"style\": {\n      \"stroke\": (e,t)=>String(t.data?.stroke??\"#9baed4\"),\n      \"lineWidth\": 1.5,\n      \"curveOffset\": 40\n    }\n  },\n  \"behaviors\": [\n    \"drag-canvas\",\n    \"drag-node\",\n    \"hover-highlight\"\n  ],\n  \"layout\": {\n    \"type\": \"mindmap\",\n    \"direction\": \"H\",\n    \"levelGap\": 40,\n    \"nodeGap\": 120,\n    \"getSide\": (e: { data?: Record<string, unknown> }) =>e.data?.side===\"left\"?\"left\":\"right\"\n  }\n});\n\nawait graph.render();\n\n\n// Call graph.destroy() when the component unmounts.","html":"<pre class=\"shiki github-dark\" style=\"background-color:#24292e;color:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#F97583\">import</span><span style=\"color:#E1E4E8\"> { Graph, register } </span><span style=\"color:#F97583\">from</span><span style=\"color:#9ECBFF\"> '@antv/g6-lite'</span><span style=\"color:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#F97583\">import</span><span style=\"color:#E1E4E8\"> mindmap </span><span style=\"color:#F97583\">from</span><span style=\"color:#9ECBFF\"> '@antv/g6-lite/layouts/mindmap'</span><span style=\"color:#E1E4E8\">;</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#B392F0\">register</span><span style=\"color:#E1E4E8\">(</span><span style=\"color:#9ECBFF\">'layout'</span><span style=\"color:#E1E4E8\">, </span><s