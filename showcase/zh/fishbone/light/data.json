{"source":"import { Graph, register } from '@antv/g6-lite';\nimport fishbone from '@antv/g6-lite/layouts/fishbone';\n\nregister('layout', 'fishbone', fishbone);\n\n// HTML: <div id=\"container\" style=\"height: 360px\"></div>\nconst data = {\n  nodes: [\n    {\"id\":\"交付延期\",\"data\":{\"fill\":\"#596bc0\",\"stroke\":\"#4d5eaf\",\"labelColor\":\"#ffffff\"}},\n    {\"id\":\"人员\",\"data\":{\"fill\":\"#e7efff\",\"stroke\":\"#7e9fd5\",\"labelColor\":\"#315f9c\"}},\n    {\"id\":\"流程\",\"data\":{\"fill\":\"#e1f4eb\",\"stroke\":\"#6db49d\",\"labelColor\":\"#246d58\"}},\n    {\"id\":\"技术\",\"data\":{\"fill\":\"#fff0d8\",\"stroke\":\"#d6ab60\",\"labelColor\":\"#87601f\"}},\n    {\"id\":\"资源\",\"data\":{\"fill\":\"#fbe6ef\",\"stroke\":\"#d38ba8\",\"labelColor\":\"#98496b\"}},\n    {\"id\":\"沟通不足\",\"data\":{\"fill\":\"#e7efff\",\"stroke\":\"#7e9fd5\",\"labelColor\":\"#315f9c\"}},\n    {\"id\":\"需求变更\",\"data\":{\"fill\":\"#e1f4eb\",\"stroke\":\"#6db49d\",\"labelColor\":\"#246d58\"}},\n    {\"id\":\"接口依赖\",\"data\":{\"fill\":\"#fff0d8\",\"stroke\":\"#d6ab60\",\"labelColor\":\"#87601f\"}},\n    {\"id\":\"排期冲突\",\"data\":{\"fill\":\"#fbe6ef\",\"stroke\":\"#d38ba8\",\"labelColor\":\"#98496b\"}}\n  ],\n  edges: [\n    {\"source\":\"交付延期\",\"target\":\"人员\"},\n    {\"source\":\"交付延期\",\"target\":\"流程\"},\n    {\"source\":\"交付延期\",\"target\":\"技术\"},\n    {\"source\":\"交付延期\",\"target\":\"资源\"},\n    {\"source\":\"人员\",\"target\":\"沟通不足\"},\n    {\"source\":\"流程\",\"target\":\"需求变更\"},\n    {\"source\":\"技术\",\"target\":\"接口依赖\"},\n    {\"source\":\"资源\",\"target\":\"排期冲突\"}\n  ],\n};\n\nconst graph = new Graph({\n  container: '#container',\n  data,\n  \"theme\": {\n    \"type\": \"light\",\n    \"canvasBackground\": \"#ffffff\"\n  },\n  \"autoFit\": {\n    \"padding\": 24\n  },\n  \"label\": {\n    \"scaleWithZoom\": false\n  },\n  \"node\": {\n    \"type\": \"rect\",\n    \"style\": {\n      \"width\": 80,\n      \"height\": 30,\n      \"borderRadius\": 6,\n      \"fill\": e=>String(e.data?.fill??\"#7087cf\"),\n      \"label\": e=>e.id,\n      \"labelPlacement\": \"center\",\n      \"labelFontSize\": 12,\n      \"labelColor\": e=>String(e.data?.labelColor??\"#3d508e\"),\n      \"stroke\": e=>String(e.data?.stroke??\"#c7d1f0\")\n    }\n  },\n  \"edge\": {\n    \"type\": \"polyline\",\n    \"style\": {\n      \"stroke\": (e,t)=>String(t.data?.stroke??\"#9baed4\"),\n      \"lineWidth\": 1.5,\n      \"router\": \"fishbone\"\n    }\n  },\n  \"behaviors\": [\n    \"drag-canvas\",\n    \"drag-node\",\n    \"hover-highlight\"\n  ],\n  \"layout\": {\n    \"type\": \"fishbone\",\n    \"direction\": \"LR\",\n    \"categoryGap\": 110,\n    \"categoryDistance\": 100,\n    \"itemHStep\": 30\n  }\n});\n\nawait graph.render();\n\n\n// 组件卸载时调用 graph.destroy()。","html":"<pre class=\"shiki github-dark\" style=\"background-color:#24292e;color:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#F97583\">import</span><span style=\"color:#E1E4E8\"> { Graph, register } </span><span style=\"color:#F97583\">from</span><span style=\"color:#9ECBFF\"> '@antv/g6-lite'</span><span style=\"color:#E1E4E8\">;</span></span>\n<span class=\"line\"><span style=\"color:#F97583\">import</span><span style=\"color:#E1E4E8\"> fishbone </span><span style=\"color:#F97583\">from</span><span style=\"color:#9ECBFF\"> '@antv/g6-lite/layouts/fishbone'</span><span style=\"color:#E1E4E8\">;</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#B392F0\">register</span><span style=\"color:#E1E4E8\">(</span><span style=\"color:#9ECBFF\">'layout'</span><span style=\"color:#E1E4E8\">, </span><span style=\"color:#9ECBFF\">'fishbone'</span><span style=\"color:#E1E4E8\">, fishbone);</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#6A737D\">// HTML: &#x3C;div id=\"container\" style=\"height: 360px\">&#x3C;/div></span></span>\n<span class=\"line\"><span style=\"color:#F97583\">const</span><span style=\"color:#79B