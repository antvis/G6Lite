{"source":"import { Graph } from '@antv/g6-lite';\n\n// HTML: <div id=\"container\" style=\"height: 360px\"></div>\nconst data = {\n  nodes: [\n    {\"id\":\"产品团队\",\"data\":{\"fill\":\"#aabaf4\",\"stroke\":\"#c0ceff\",\"labelColor\":\"#182340\"}},\n    {\"id\":\"设计\",\"data\":{\"fill\":\"#462c3d\",\"stroke\":\"#d690b2\",\"labelColor\":\"#f4c3da\"}},\n    {\"id\":\"研发\",\"data\":{\"fill\":\"#243954\",\"stroke\":\"#79a4df\",\"labelColor\":\"#c0d9ff\"}},\n    {\"id\":\"运营\",\"data\":{\"fill\":\"#203d35\",\"stroke\":\"#6bb9a0\",\"labelColor\":\"#b6e6d5\"}},\n    {\"id\":\"体验设计\",\"data\":{\"fill\":\"#462c3d\",\"stroke\":\"#d690b2\",\"labelColor\":\"#f4c3da\"}},\n    {\"id\":\"前端开发\",\"data\":{\"fill\":\"#243954\",\"stroke\":\"#79a4df\",\"labelColor\":\"#c0d9ff\"}},\n    {\"id\":\"后端开发\",\"data\":{\"fill\":\"#243954\",\"stroke\":\"#79a4df\",\"labelColor\":\"#c0d9ff\"}}\n  ],\n  edges: [\n    {\"source\":\"产品团队\",\"target\":\"设计\"},\n    {\"source\":\"产品团队\",\"target\":\"研发\"},\n    {\"source\":\"产品团队\",\"target\":\"运营\"},\n    {\"source\":\"设计\",\"target\":\"体验设计\"},\n    {\"source\":\"研发\",\"target\":\"前端开发\"},\n    {\"source\":\"研发\",\"target\":\"后端开发\"}\n  ],\n};\n\nconst graph = new Graph({\n  container: '#container',\n  data,\n  \"theme\": {\n    \"type\": \"dark\",\n    \"canvasBackground\": \"#10151c\"\n  },\n  \"autoFit\": {\n    \"padding\": 24\n  },\n  \"label\": {\n    \"scaleWithZoom\": false\n  },\n  \"node\": {\n    \"type\": \"rect\",\n    \"style\": {\n      \"width\": 100,\n      \"height\": 36,\n      \"borderRadius\": 8,\n      \"fill\": e=>String(e.data?.fill??\"#7087cf\"),\n      \"stroke\": e=>String(e.data?.stroke??\"#c7d1f0\"),\n      \"strokeWidth\": 1,\n      \"label\": e=>e.id,\n      \"labelPlacement\": \"center\",\n      \"labelFontSize\": 13,\n      \"labelColor\": e=>String(e.data?.labelColor??\"#3d508e\")\n    }\n  },\n  \"edge\": {\n    \"type\": \"polyline\",\n    \"style\": {\n      \"stroke\": (e,t)=>String(t.data?.stroke??\"#9baed4\"),\n      \"lineWidth\": 1.5,\n      \"router\": \"tree\",\n      \"endArrow\": false\n    }\n  },\n  \"behaviors\": [\n    \"drag-canvas\",\n    \"drag-node\",\n    \"hover-highlight\"\n  ],\n  \"layout\": {\n    \"type\": \"dagre\",\n    \"rankdir\": \"TB\",\n    \"nodesep\": 32,\n    \"ranksep\": 70,\n    \"nodeSize\": [\n      100,\n      36\n    ]\n  }\n});\n\nawait graph.render();\n\n\n// 组件卸载时调用 graph.destroy()。","html":"<pre class=\"shiki github-dark\" style=\"background-color:#24292e;color:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#F97583\">import</span><span style=\"color:#E1E4E8\"> { Graph } </span><span style=\"color:#F97583\">from</span><span style=\"color:#9ECBFF\"> '@antv/g6-lite'</span><span style=\"color:#E1E4E8\">;</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#6A737D\">// HTML: &#x3C;div id=\"container\" style=\"height: 360px\">&#x3C;/div></span></span>\n<span class=\"line\"><span style=\"color:#F97583\">const</span><span style=\"color:#79B8FF\"> data</span><span style=\"color:#F97583\"> =</span><span style=\"color:#E1E4E8\"> {</span></span>\n<span class=\"line\"><span style=\"color:#E1E4E8\">  nodes: [</span></span>\n<span class=\"line\"><span style=\"color:#E1E4E8\">    {</span><span style=\"color:#9ECBFF\">\"id\"</span><span style=\"color:#E1E4E8\">:</span><span style=\"color:#9ECBFF\">\"产品团队\"</span><span style=\"color:#E1E4E8\">,</span><span style=\"color:#9ECBFF\">\"data\"</span><span style=\"color:#E1E4E8\">:{</span><span style=\"color:#9ECBFF\">\"fill\"</span><span style=\"color:#E1E4E8\">:</span><span style=\"color:#9ECBFF\">\"#aabaf4\"</span><span style=\"color:#E1E4E8\">,</span><span style=\"color:#9ECBFF\">\"stroke\"</span><span style=\"color:#E1E4E8\">:</span><span style=\"color:#9ECBFF\">\"#c0ceff\"</span><span style=\"color:#E1E4E8\">,</span><span style=\"color:#9ECBFF\">\"labelColor\"</span><span style=\"color:#E1E4E8\">:</span><span style=\"color:#9ECBFF\">\"#18