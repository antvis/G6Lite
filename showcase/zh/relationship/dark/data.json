{"source":"import { Graph } from '@antv/g6-lite';\n\n// HTML: <div id=\"container\" style=\"height: 360px\"></div>\nconst data = {\n  nodes: [\n    {\"id\":\"G6Lite\",\"x\":280,\"y\":200,\"data\":{\"fill\":\"#aabaf4\",\"stroke\":\"#354873\",\"labelColor\":\"#dce5ff\"}},\n    {\"id\":\"React\",\"x\":135,\"y\":80,\"data\":{\"fill\":\"#79a4df\",\"stroke\":\"#243954\",\"labelColor\":\"#c0d9ff\"}},\n    {\"id\":\"Vue\",\"x\":280,\"y\":45,\"data\":{\"fill\":\"#6bb9a0\",\"stroke\":\"#203d35\",\"labelColor\":\"#b6e6d5\"}},\n    {\"id\":\"TypeScript\",\"x\":425,\"y\":80,\"data\":{\"fill\":\"#79a4df\",\"stroke\":\"#243954\",\"labelColor\":\"#c0d9ff\"}},\n    {\"id\":\"WebGL\",\"x\":465,\"y\":235,\"data\":{\"fill\":\"#d4ad66\",\"stroke\":\"#463820\",\"labelColor\":\"#f3d69c\"}},\n    {\"id\":\"布局\",\"x\":365,\"y\":350,\"data\":{\"fill\":\"#d690b2\",\"stroke\":\"#462c3d\",\"labelColor\":\"#f4c3da\"}},\n    {\"id\":\"数据\",\"x\":195,\"y\":350,\"data\":{\"fill\":\"#6bb9a0\",\"stroke\":\"#203d35\",\"labelColor\":\"#b6e6d5\"}},\n    {\"id\":\"交互\",\"x\":95,\"y\":235,\"data\":{\"fill\":\"#d690b2\",\"stroke\":\"#462c3d\",\"labelColor\":\"#f4c3da\"}}\n  ],\n  edges: [\n    {\"source\":\"G6Lite\",\"target\":\"React\"},\n    {\"source\":\"G6Lite\",\"target\":\"Vue\"},\n    {\"source\":\"G6Lite\",\"target\":\"TypeScript\"},\n    {\"source\":\"G6Lite\",\"target\":\"WebGL\"},\n    {\"source\":\"G6Lite\",\"target\":\"布局\"},\n    {\"source\":\"G6Lite\",\"target\":\"数据\"},\n    {\"source\":\"G6Lite\",\"target\":\"交互\"}\n  ],\n};\n\nconst graph = new Graph({\n  container: '#container',\n  data,\n  \"theme\": {\n    \"type\": \"dark\",\n    \"canvasBackground\": \"#10151c\"\n  },\n  \"autoFit\": {\n    \"padding\": 24\n  },\n  \"label\": {\n    \"scaleWithZoom\": false\n  },\n  \"node\": {\n    \"type\": \"circle\",\n    \"style\": {\n      \"size\": 28,\n      \"fill\": e=>String(e.data?.fill??\"#7087cf\"),\n      \"stroke\": e=>String(e.data?.stroke??\"#c7d1f0\"),\n      \"strokeWidth\": 6,\n      \"label\": e=>e.id,\n      \"labelPlacement\": \"bottom\",\n      \"labelFontSize\": 13,\n      \"labelColor\": e=>String(e.data?.labelColor??\"#3d508e\")\n    }\n  },\n  \"edge\": {\n    \"type\": \"line\",\n    \"style\": {\n      \"stroke\": (e,t)=>String(t.data?.fill??\"#9baed4\"),\n      \"lineWidth\": 1.5\n    },\n    \"stateStyles\": {\n      \"highlight\": {\n        \"stroke\": \"#a9c4ff\",\n        \"lineWidth\": 3,\n        \"opacity\": 1\n      }\n    }\n  },\n  \"behaviors\": [\n    \"drag-canvas\",\n    \"drag-node\",\n    \"highlight-node\"\n  ]\n});\n\nawait graph.render();\n\nlet highlightedEdges: string[] = [];\nconst clearHighlight = () => {\n  graph.batchSetState(highlightedEdges.map((id) => ({ id, state: 'highlight', value: false })));\n  highlightedEdges = [];\n};\ngraph.on('node:pointerover', ({ nodeId }) => {\n  clearHighlight();\n  highlightedEdges = graph.getEdges()\n    .filter((edge) => edge.source === nodeId || edge.target === nodeId)\n    .map((edge) => edge.id);\n  graph.batchSetState(highlightedEdges.map((id) => ({ id, state: 'highlight', value: true })));\n});\ngraph.on('node:pointerleave', clearHighlight);\n\n\n// 组件卸载时调用 graph.destroy()。","html":"<pre class=\"shiki github-dark\" style=\"background-color:#24292e;color:#e1e4e8\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#F97583\">import</span><span style=\"color:#E1E4E8\"> { Graph } </span><span style=\"color:#F97583\">from</span><span style=\"color:#9ECBFF\"> '@antv/g6-lite'</span><span style=\"color:#E1E4E8\">;</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#6A737D\">// HTML: &#x3C;div id=\"container\" style=\"height: 360px\">&#x3C;/div></span></span>\n<span class=\"line\"><span style=\"color:#F97583\">const</span><span style=\"color:#79B8FF\"> data</span><span style=\"color:#F97583\"> =</span><span style=\"color:#E1E4E8\"> {</span></span>\n<span class=\"line\"><span style=\"color:#E1E4E8\">  nodes: [</span></span>\n<s