{
  "name": "website",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "build": "npm run docs:nav:check && fumadocs-mdx && _FUMADOCS_MDX=1 next build",
    "dev": "next dev",
    "start": "serve out",
    "types:check": "fumadocs-mdx && _FUMADOCS_MDX=1 next typegen && tsc --noEmit",
    "postinstall": "fumadocs-mdx",
    "lint": "eslint",
    "docs:nav": "node scripts/sync-docs-navigation.mjs",
    "docs:nav:check": "node scripts/sync-docs-navigation.mjs --check",
    "docs:output:check": "python3 scripts/check-docs-output.py && node scripts/check-example-documentation.mjs && node scripts/check-example-audit.mjs"
  },
  "dependencies": {
    "@codemirror/lang-javascript": "^6.2.5",
    "@uiw/react-codemirror": "^4.25.12",
    "fumadocs-core": "16.9.3",
    "fumadocs-mdx": "15.0.11",
    "fumadocs-ui": "16.9.3",
    "lucide-react": "^1.17.0",
    "next": "16.2.7",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "sucrase": "^3.35.1",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.0",
    "@types/mdx": "^2.0.13",
    "@types/node": "^25.9.1",
    "@types/react": "^19.2.16",
    "@types/react-dom": "^19.2.3",
    "eslint": "^9.39.4",
    "eslint-config-next": "16.2.7",
    "playwright": "^1.60.0",
    "postcss": "^8.5.15",
    "serve": "^14.2.6",
    "shiki": "^4.2.0",
    "tailwindcss": "^4.3.0",
    "typescript": "^6.0.3"
  },
  "overrides": {
    "mdast-util-to-markdown": "2.1.2"
  }
}
