{
  "name": "website",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "build": "fumadocs-mdx && _FUMADOCS_MDX=1 next build",
    "dev": "next dev",
    "start": "serve out",
    "types:check": "fumadocs-mdx && _FUMADOCS_MDX=1 next typegen && tsc --noEmit",
    "postinstall": "fumadocs-mdx",
    "lint": "eslint",
    "thumbnails:capture": "(cd .. && vite --config vite.config.ts --port 5179 --no-open) & sleep 5 && node scripts/capture-thumbnails.mjs; kill %1",
    "examples:capture": "(cd .. && vite --config vite.config.ts --port 5179 --no-open) & sleep 5 && node scripts/capture-demo-thumbnails.mjs; kill %1"
  },
  "dependencies": {
    "fumadocs-core": "16.9.3",
    "fumadocs-mdx": "15.0.11",
    "fumadocs-ui": "16.9.3",
    "next": "16.2.7",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.0",
    "@types/mdx": "^2.0.13",
    "@types/node": "^25.9.1",
    "@types/react": "^19.2.16",
    "@types/react-dom": "^19.2.3",
    "eslint": "^9.39.4",
    "eslint-config-next": "16.2.7",
    "playwright": "^1.60.0",
    "postcss": "^8.5.15",
    "serve": "^14.2.6",
    "tailwindcss": "^4.3.0",
    "typescript": "^6.0.3"
  }
}
