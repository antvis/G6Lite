{
  "compilerOptions": {
    "target": "ESNext",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "forceConsistentCasingInFileNames": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "@antv/g6-lite": [
        "../src/index.ts"
      ],
      "@antv/g6-lite/layouts/mds": [
        "../src/layout/optional/mds.ts"
      ],
      "@antv/g6-lite/layouts/radial": [
        "../src/layout/optional/radial.ts"
      ],
      "@antv/g6-lite/layouts/indented": [
        "../src/layout/optional/indented.ts"
      ],
      "@antv/g6-lite/layouts/mindmap": [
        "../src/layout/optional/mindmap.ts"
      ],
      "@antv/g6-lite/layouts/fishbone": [
        "../src/layout/optional/fishbone.ts"
      ],
      "@antv/g6-lite/layouts/random": [
        "../src/layout/optional/random.ts"
      ],
      "collections/*": [
        "./.source/*"
      ]
    },
    "plugins": [
      {
        "name": "next"
      }
    ]
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "out"
  ]
}
